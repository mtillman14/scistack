diff --git a/scidb/src/scidb/foreach_call.py b/scidb/src/scidb/foreach_call.py
new file mode 100644
index 00000000..6c532f0c
--- /dev/null
+++ b/scidb/src/scidb/foreach_call.py
@@ -0,0 +1,167 @@
+"""One ``scidb.for_each`` call as a value: its options in three bundles.
+
+``scidb.for_each`` keeps its keyword signature for users (28 keywords, the
+ones :data:`SCIDB_FOR_EACH_OPTIONS` declares). Internally the keywords are
+grouped once, at entry, into a :class:`ForEachCall`:
+
+* :class:`~scidb.foreach_config.RunOptions` (``run``) — the identity-bearing
+  execution modes (``as_table``, ``distribute``);
+* :class:`RunSelection` (``selection``) — which locations and rows the call
+  reads (``where``, ``locations``, ``schema_filter``, ``schema_keys``, the
+  metadata iterables);
+* :class:`RunContext` (``context``) — facts about the call that steer or are
+  recorded but are never identity (``step``, ``parameter_names``,
+  ``finalized``, ``pipeline``, the private hooks);
+
+and the rest stay plain fields. Which bundle an option belongs to is declared
+once, on its :class:`scifor.OptionSpec`; this module only reads the
+declaration. A recursion (``step=``, EachOf alternatives) or a deferred
+pipeline step re-runs the SAME value with one field replaced, so no hand-written
+kwarg list can drop an option (``glue=`` and ``locations=`` were each lost
+that way once).
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field, replace
+from typing import Any
+
+from scifor import FOR_EACH_OPTIONS, UNSET, OptionSpec
+
+from .foreach_config import RunOptions
+
+#: scidb's private hooks, beyond the user options scifor declares. Not part
+#: of the drop-in contract (a leading underscore), all in the ``context``.
+SCIDB_HOOK_OPTIONS: "tuple[OptionSpec, ...]" = (
+    OptionSpec("_inject_combo_metadata", False, "bool", "context", db_only=True),
+    OptionSpec("_pre_combo_hook", None, "object", "context", db_only=True),
+    OptionSpec("_progress_fn", None, "object", "context", db_only=True),
+    OptionSpec("_cancel_check", None, "object", "context", db_only=True),
+)
+
+#: Every keyword ``scidb.for_each`` takes besides ``fn``/``inputs``/``outputs``
+#: and the metadata iterables, in signature order.
+SCIDB_FOR_EACH_OPTIONS: "tuple[OptionSpec, ...]" = FOR_EACH_OPTIONS + SCIDB_HOOK_OPTIONS
+
+
+@dataclass(frozen=True)
+class RunSelection:
+    """Which locations and rows a call reads.
+
+    ``schema_filter`` and ``schema_keys`` are resolved into
+    ``metadata_iterables`` / ``where`` once, at entry; afterwards both are
+    None, so a recursion never resolves them twice.
+    """
+
+    where: Any = None
+    locations: Any = None
+    schema_filter: "Mapping[str, list] | None" = None
+    schema_keys: "list[str] | None" = None
+    metadata_iterables: "dict[str, Any]" = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class RunContext:
+    """Facts about a call that steer it or are recorded, never identity."""
+
+    finalized: bool = False
+    parameter_names: "dict[str, str] | None" = None
+    step: "str | None" = None
+    #: A Pipeline to register into, None (run eagerly), or UNSET (use the
+    #: active pipeline, if any).
+    pipeline: Any = UNSET
+    #: Pass the combination's schema-key values to the function as keyword
+    #: arguments it accepts (generates_file and endpoint functions).
+    inject_combo_metadata: bool = False
+    #: ``combo -> bool``; True skips the combination before anything loads
+    #: (``skip_computed`` installs one).
+    pre_combo_hook: "Callable[[dict], bool] | None" = None
+    progress_fn: "Callable[[dict], None] | None" = None
+    cancel_check: "Callable[[], bool] | None" = None
+
+    def cancelled(self) -> bool:
+        """Has the caller asked the run to stop?"""
+        return self.cancel_check is not None and bool(self.cancel_check())
+
+
+@dataclass(frozen=True)
+class ForEachCall:
+    """One ``scidb.for_each`` call, its keywords bundled (module docstring)."""
+
+    fn: Callable
+    inputs: "dict[str, Any]"
+    outputs: "list[Any]"
+    run: RunOptions = field(default_factory=RunOptions)
+    selection: RunSelection = field(default_factory=RunSelection)
+    context: RunContext = field(default_factory=RunContext)
+    dry_run: bool = False
+    save: bool = True
+    db: Any = None
+    introspect: bool = False
+    skip_computed: bool = False
+    schema_key_types: "dict[str, str] | None" = None
+    on_error: str = "continue"
+    on_duplicate: str = "error"
+    share_limits: "dict[str, list[str]] | None" = None
+    project_root: Any = None
+    glue: "dict[str, Any] | None" = None
+
+    @classmethod
+    def from_options(
+        cls,
+        fn: Callable,
+        inputs: "dict[str, Any]",
+        outputs: "list[Any]",
+        metadata_iterables: "Mapping[str, Any]",
+        **options: Any,
+    ) -> "ForEachCall":
+        """Bundle the keywords of one call. ``options`` must name every
+        option in :data:`SCIDB_FOR_EACH_OPTIONS`, so an option added to the
+        declaration but not passed through here fails loudly."""
+        declared = {spec.name for spec in SCIDB_FOR_EACH_OPTIONS}
+        if set(options) != declared:
+            raise TypeError(
+                f"ForEachCall.from_options: missing {sorted(declared - set(options))}, "
+                f"unexpected {sorted(set(options) - declared)}"
+            )
+        bundles: "dict[str, dict[str, Any]]" = {
+            "run": {},
+            "selection": {"metadata_iterables": dict(metadata_iterables)},
+            "context": {},
+        }
+        loose: "dict[str, Any]" = {}
+        for spec in SCIDB_FOR_EACH_OPTIONS:
+            target = bundles[spec.bundle] if spec.bundle is not None else loose
+            target[spec.attribute] = options[spec.name]
+        return cls(
+            fn=fn,
+            inputs=inputs,
+            outputs=outputs,
+            run=RunOptions(**bundles["run"]),
+            selection=RunSelection(**bundles["selection"]),
+            context=RunContext(**bundles["context"]),
+            **loose,
+        )
+
+    def option_values(self) -> "dict[str, Any]":
+        """The call's keywords, as ``scidb.for_each`` takes them (minus
+        ``pipeline``, so a replay runs instead of registering again)."""
+        values: "dict[str, Any]" = {}
+        for spec in SCIDB_FOR_EACH_OPTIONS:
+            if spec.name == "pipeline":
+                continue
+            holder = getattr(self, spec.bundle) if spec.bundle is not None else self
+            values[spec.name] = getattr(holder, spec.attribute)
+        return values
+
+    @property
+    def metadata_iterables(self) -> "dict[str, Any]":
+        return self.selection.metadata_iterables
+
+    def with_selection(self, **changes: Any) -> "ForEachCall":
+        return replace(self, selection=replace(self.selection, **changes))
+
+    def with_context(self, **changes: Any) -> "ForEachCall":
+        return replace(self, context=replace(self.context, **changes))
+
+    def with_run(self, **changes: Any) -> "ForEachCall":
+        return replace(self, run=replace(self.run, **changes))
diff --git a/scidb/src/scidb/record_store.py b/scidb/src/scidb/record_store.py
new file mode 100644
index 00000000..0299a173
--- /dev/null
+++ b/scidb/src/scidb/record_store.py
@@ -0,0 +1,416 @@
+"""``RecordStore``: the SQL that reads and writes a variable's stored records.
+
+One object over one ``SciDuck`` connection, holding the queries against the
+storage tables — ``_variables``, ``_registered_types``, the ``<Type>_data``
+tables (and their ``information_schema`` entry), ``_record`` / ``_record_save``
+and ``_schema`` — that used to be spelled in two places: ``DatabaseManager``
+and ``scistackplotdb.load`` (design review 06 PD1). A layer that wants a
+variable's records asks this; it does not write its own SELECT.
+
+* **catalog** — :meth:`schema_keys`, :meth:`variable_names`,
+  :meth:`table_name`, :meth:`stored_column_types`, :meth:`dtype_meta`;
+* **read** — :meth:`long_frame` (every non-excluded record of a variable as one
+  frame, the bulk read plotting needs), :meth:`sample_cell`,
+  :meth:`column_levels`, :meth:`occupied_keys`;
+* **write** — :meth:`write_batch_rows` (the inserts of a planned batch save,
+  ``DatabaseManager._plan_batch_rows`` -> :class:`BatchRows`) and
+  :meth:`insert_columnar_frames`.
+
+Payload columns are only ever fetched through ``fetchdf`` (one numpy buffer
+per cell), never ``fetchall`` (a Python float per sample): measured 18x on
+2026-09-13, ``.claude/plot-at-scale-plan.md`` §7.
+"""
+
+import json
+import time
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+import pandas as pd
+
+from .log import Log
+from .sciduck import SciDuck
+
+
+@dataclass
+class BatchRows:
+    """One batch save, planned: everything ``save_batch`` computes before its
+    inserts (``DatabaseManager._plan_batch_rows``), and what the inserts
+    (:meth:`RecordStore.write_batch_rows`) and the timing line read.
+
+    ``record_ids`` align with the items that passed validation;
+    :meth:`aligned_record_ids` maps them back to the caller's order with None
+    in each skipped slot. ``writable`` is False when nothing in the batch can
+    be stored (no usable schema, or every record skipped).
+    """
+
+    variable_class: type
+    table_name: str
+    n_original: int
+    timings: dict
+    t0: float
+    is_custom: bool = False
+    is_dataframe: bool = False
+    data_col_types: dict = field(default_factory=dict)
+    dtype_meta: dict = field(default_factory=dict)
+    #: on_duplicate="combine" row-list columns under their STORED names.
+    stored_row_lists: list = field(default_factory=list)
+    #: The caller's index of each item that passed validation.
+    valid_orig_idx: "list[int]" = field(default_factory=list)
+    skipped: bool = False
+    #: (schema level, key values) -> schema id
+    schema_ids: dict = field(default_factory=dict)
+    unique_schemas: int = 0
+    record_ids: "list[str]" = field(default_factory=list)
+    #: (record_id, *storage values) per data-table row.
+    data_rows: "list[tuple]" = field(default_factory=list)
+    #: (record_id, timestamp, type, schema_id, content_hash, schema_version)
+    metadata_rows: "list[tuple]" = field(default_factory=list)
+    #: Arrow fast path (multi-column 1-D arrays): column -> per-record arrays.
+    arrow_columns: "dict[str, list] | None" = None
+    #: Custom serialization: (record_id, to_db frame) per record.
+    custom_frames: list = field(default_factory=list)
+    effective_level: "str | None" = None
+    hash_paths: str = ""
+    n_new: int = 0
+    writable: bool = False
+
+    def aligned_record_ids(self) -> "list[str | None]":
+        """Record ids in the caller's item order, None where skipped."""
+        if not self.writable:
+            return [None] * self.n_original
+        if not self.skipped:
+            return list(self.record_ids)
+        aligned: "list[str | None]" = [None] * self.n_original
+        for pos, orig_idx in enumerate(self.valid_orig_idx):
+            aligned[orig_idx] = self.record_ids[pos]
+        return aligned
+
+
+#: The non-excluded records of ONE variable type (``r.type = ?``), joined to
+#: their data table ``t`` and schema location ``s``. Every per-variable read
+#: filters on ``_record.type``: ``_registered_types.table_name`` is not
+#: unique, so a shared table read without it would mix two variables.
+_RECORDS_OF_TYPE = (
+    "JOIN _record r ON t.record_id = r.record_id "
+    "LEFT JOIN _schema s ON r.schema_id = s.schema_id "
+    "WHERE r.type = ? AND r.excluded IS DISTINCT FROM TRUE"
+)
+
+
+class RecordStore:
+    """The storage-table SQL over one connection (module docstring)."""
+
+    def __init__(self, duck: SciDuck):
+        self._duck = duck
+
+    @property
+    def connection(self) -> SciDuck:
+        return self._duck
+
+    # -- catalog ---------------------------------------------------------------
+
+    def schema_keys(self) -> "list[str]":
+        """The dataset's schema keys, in order."""
+        return list(self._duck.dataset_schema)
+
+    def variable_names(self) -> "list[str]":
+        """Every variable with a ``_variables`` row, sorted."""
+        rows = self._duck.fetchall("SELECT variable_name FROM _variables ORDER BY variable_name")
+        return [row[0] for row in rows]
+
+    def table_name(self, type_name: str) -> str:
+        """A variable's data table (``_registered_types``), else ``<Type>_data``."""
+        row = self._duck.fetchone(
+            "SELECT table_name FROM _registered_types WHERE type_name = ?", [type_name]
+        )
+        return row[0] if row and row[0] else f"{type_name}_data"
+
+    def stored_column_types(self, type_name: str) -> "dict[str, str]":
+        """``{column: DuckDB type}`` of the variable's data table as stored
+        (datetime zone companions included, ``record_id`` not), in ordinal
+        order."""
+        rows = self._duck.fetchall(
+            "SELECT column_name, data_type FROM information_schema.columns "
+            "WHERE table_name = ? AND column_name != 'record_id' "
+            "ORDER BY ordinal_position",
+            [self.table_name(type_name)],
+        )
+        return {row[0]: str(row[1] or "") for row in rows}
+
+    def dtype_meta(self, type_name: str) -> "dict | None":
+        """The stored ``dtype`` metadata of a variable (``_variables.dtype``),
+        or None when it has none."""
+        rows = self._duck.fetchall(
+            "SELECT dtype FROM _variables WHERE variable_name = ?", [type_name]
+        )
+        if not rows or not rows[0][0]:
+            return None
+        raw = rows[0][0]
+        return json.loads(raw) if isinstance(raw, str) else raw
+
+    # -- read ------------------------------------------------------------------
+
+    def long_frame(self, type_name: str, columns: "Sequence[str]" = ()) -> pd.DataFrame:
+        """Every non-excluded record of a variable as one frame:
+        ``record_id``, the given data ``columns`` (as stored: a datetime
+        column's ``__tz`` companion must be named to come along), then every
+        schema key AS TEXT.
+
+        No columns is the metadata-only read: record ids and schema keys, and
+        no payload in the SELECT at all. Through ``fetchdf`` always.
+
+        Schema keys are cast to VARCHAR in the query, not stringified after: a
+        DataFrame fetch types each column, and an integer key with one NULL
+        among its rows would arrive as float64 and stringify as "1.0".
+        """
+        data_select = "".join(f', t."{column}"' for column in columns)
+        schema_select = "".join(
+            f', CAST(s."{key}" AS VARCHAR) AS "{key}"' for key in self.schema_keys()
+        )
+        query = (
+            f"SELECT t.record_id{data_select}{schema_select} "
+            f'FROM "{self.table_name(type_name)}" t {_RECORDS_OF_TYPE}'
+        )
+        t0 = time.perf_counter()
+        frame = self._duck.fetchdf(query, [type_name])
+        Log.debug(
+            f"RecordStore.long_frame({type_name}): {len(frame)} record(s), "
+            f"{len(columns)} data column(s) in {time.perf_counter() - t0:.3f}s"
+        )
+        return frame
+
+    def sample_cell(self, type_name: str, column: str) -> Any:
+        """One non-NULL value of one data column (of a non-excluded record),
+        or None when the column holds none."""
+        row = self._duck.fetchone(
+            f'SELECT t."{column}" FROM "{self.table_name(type_name)}" t '
+            f"{_RECORDS_OF_TYPE} "
+            f'AND t."{column}" IS NOT NULL LIMIT 1',
+            [type_name],
+        )
+        return row[0] if row else None
+
+    def column_levels(self, type_name: str, column: str, *, limit: int) -> "list[str]":
+        """Distinct values of one data column, as text, at most ``limit``."""
+        rows = self._duck.fetchall(
+            f'SELECT DISTINCT CAST(t."{column}" AS VARCHAR) AS level '
+            f'FROM "{self.table_name(type_name)}" t '
+            f"{_RECORDS_OF_TYPE} "
+            f'AND t."{column}" IS NOT NULL '
+            f"LIMIT {int(limit)}",
+            [type_name],
+        )
+        return [row[0] for row in rows]
+
+    def occupied_keys(self, type_name: str) -> "list[str]":
+        """The schema keys a variable's non-excluded records populate, without
+        reading any data (COUNT ignores NULLs, so one row of counts says
+        exactly which keys are populated)."""
+        keys = self.schema_keys()
+        if not keys:
+            return []
+        counts = ", ".join(f'COUNT(s."{key}")' for key in keys)
+        row = self._duck.fetchone(
+            f"SELECT {counts} FROM _record r "
+            f"LEFT JOIN _schema s ON r.schema_id = s.schema_id "
+            f"WHERE r.type = ? AND r.excluded IS DISTINCT FROM TRUE",
+            [type_name],
+        )
+        if row is None:
+            return []
+        return [key for key, count in zip(keys, row, strict=True) if count]
+
+    # -- write -----------------------------------------------------------------
+
+    def write_batch_rows(self, rows: BatchRows) -> None:
+        """The inserts of a planned batch, in one re-entrant transaction:
+        the data rows (deduplicated by record id), the ``_record_save``
+        audit rows, the ``_record`` entities, and the ``_variables`` row."""
+        from .provenance import insert_record_entities
+
+        timings = rows.timings
+        table_name = rows.table_name
+        type_name = rows.variable_class.__name__
+
+        # --- Find which data rows are new (dedup check) ---
+        t5 = time.perf_counter()
+        if rows.is_dataframe:
+            # No PRIMARY KEY: filter out rows whose record_id already exists.
+            all_new_rids = list({row[0] for row in rows.data_rows})
+            existing_rids: set = set()
+            if all_new_rids:
+                placeholders_rids = ", ".join(["?"] * len(all_new_rids))
+                existing_rids = {
+                    r[0]
+                    for r in self._duck.fetchall(
+                        f'SELECT DISTINCT record_id FROM "{table_name}" '
+                        f"WHERE record_id IN ({placeholders_rids})",
+                        all_new_rids,
+                    )
+                }
+            new_data_rows = [row for row in rows.data_rows if row[0] not in existing_rids]
+        else:
+            # PRIMARY KEY (or the Arrow / columnar insert): ON CONFLICT DO
+            # NOTHING handles dedup in the INSERT.
+            new_data_rows = rows.data_rows
+        timings["dedup_check"] = time.perf_counter() - t5
+
+        t6 = time.perf_counter()
+        # Re-entrant: inside a for_each save this joins the call's one
+        # transaction, so the data rows commit with their provenance graph.
+        with self._duck.transaction(f"save_batch({type_name})"):
+            t6a = time.perf_counter()
+            if rows.arrow_columns is not None and rows.record_ids:
+                rows.n_new = self._insert_arrow_rows(rows, t6a)
+            elif rows.is_custom:
+                timings["data_df_create"] = time.perf_counter() - t6a
+                t6b = time.perf_counter()
+                rows.n_new = self.insert_columnar_frames(table_name, rows.custom_frames)
+                timings["data_insert"] = time.perf_counter() - t6b
+            elif new_data_rows:
+                all_columns = ["record_id"] + list(rows.data_col_types.keys())
+                timings["data_df_create"] = time.perf_counter() - t6a
+                t6b = time.perf_counter()
+                self._duck.bulk_insert(
+                    table_name,
+                    all_columns,
+                    new_data_rows,
+                    conflict_cols=None if rows.is_dataframe else ["record_id"],
+                )
+                rows.n_new = len(new_data_rows)
+                timings["data_insert"] = time.perf_counter() - t6b
+            else:
+                timings["data_df_create"] = time.perf_counter() - t6a
+                timings["data_insert"] = 0.0
+
+            # Append save-event rows (audit trail — every execution logged).
+            # metadata_rows is (record_id, timestamp, variable_name, schema_id,
+            # content_hash, schema_version); _record_save keeps only the
+            # (record_id, timestamp) save-event columns.
+            t6c = time.perf_counter()
+            self._duck.bulk_insert(
+                "_record_save",
+                ["record_id", "timestamp"],
+                [(r[0], r[1]) for r in rows.metadata_rows],
+                conflict_cols=["record_id", "timestamp"],
+            )
+            timings["record_save_insert"] = time.perf_counter() - t6c
+            # The type/schema/content metadata lives on the bipartite entities
+            # table (_record); map metadata_rows to the _record column order.
+            t6c2 = time.perf_counter()
+            insert_record_entities(
+                self._duck,
+                [(r[0], r[1], r[2], r[3], r[4], r[5], False) for r in rows.metadata_rows],
+            )
+            timings["record_entities_insert"] = time.perf_counter() - t6c2
+            timings["meta_insert"] = time.perf_counter() - t6c
+
+            # Upsert _variables (one row per variable)
+            t6d = time.perf_counter()
+            self._duck.execute(
+                "INSERT INTO _variables (variable_name, schema_level, dtype, description) "
+                "VALUES (?, ?, ?, ?) "
+                "ON CONFLICT (variable_name) DO UPDATE SET dtype = excluded.dtype",
+                [type_name, rows.effective_level, json.dumps(rows.dtype_meta), ""],
+            )
+            timings["variables_upsert"] = time.perf_counter() - t6d
+            t6e = time.perf_counter()
+        timings["commit"] = time.perf_counter() - t6e
+        timings["batch_inserts"] = time.perf_counter() - t6
+        timings["total"] = time.perf_counter() - rows.t0
+
+    def _insert_arrow_rows(self, rows: BatchRows, t_start: float) -> int:
+        """PyArrow fast path: numpy arrays → Arrow buffers → DuckDB (no Python
+        list conversion). Returns the number of rows offered."""
+        import pyarrow as pa  # optional dependency; the caller checked it exists
+
+        numpy_to_arrow = {
+            "float64": pa.float64(),
+            "float32": pa.float32(),
+            "int64": pa.int64(),
+            "int32": pa.int32(),
+            "int16": pa.int16(),
+            "int8": pa.int8(),
+            "uint64": pa.uint64(),
+            "uint32": pa.uint32(),
+            "uint16": pa.uint16(),
+            "uint8": pa.uint8(),
+            "bool": pa.bool_(),
+        }
+        arrow_data = {"record_id": pa.array(rows.record_ids, type=pa.string())}
+        for col_name, np_list in (rows.arrow_columns or {}).items():
+            col_meta = rows.dtype_meta["columns"][col_name]
+            numpy_dtype = col_meta.get("numpy_dtype", "float64")
+            arrow_inner = numpy_to_arrow.get(numpy_dtype, pa.float64())
+            arrow_data[col_name] = pa.array(np_list, type=pa.list_(arrow_inner))
+        arrow_table = pa.table(arrow_data)
+        col_str = ", ".join(f'"{c}"' for c in arrow_data)
+        rows.timings["data_df_create"] = time.perf_counter() - t_start
+
+        t6b = time.perf_counter()
+        self._duck.con.register("arrow_table", arrow_table)
+        try:
+            self._duck.con.execute(
+                f'INSERT INTO "{rows.table_name}" ({col_str}) SELECT * FROM arrow_table '
+                f"ON CONFLICT (record_id) DO NOTHING"
+            )
+        finally:
+            self._duck.con.unregister("arrow_table")
+        rows.timings["data_insert"] = time.perf_counter() - t6b
+        return len(rows.record_ids)
+
+    def insert_columnar_frames(
+        self, table_name: str, frames: "list[tuple[str, pd.DataFrame]]"
+    ) -> int:
+        """Insert ``(record_id, frame)`` pairs into a columnar data table in
+        ONE statement, skipping record_ids already stored (one lookup query)
+        and repeats within *frames*. Returns the number of records inserted.
+
+        The table has no PRIMARY KEY (one row per frame row), so dedup is
+        done here rather than by ``ON CONFLICT``.
+        """
+        if not frames:
+            return 0
+        rids = list(dict.fromkeys(rid for rid, _ in frames))
+        placeholders = ", ".join(["?"] * len(rids))
+        existing = {
+            r[0]
+            for r in self._duck.fetchall(
+                f'SELECT DISTINCT record_id FROM "{table_name}" '
+                f"WHERE record_id IN ({placeholders})",
+                rids,
+            )
+        }
+        new_parts = []
+        seen: "set[str]" = set(existing)
+        for rid, df in frames:
+            if rid in seen:
+                continue
+            seen.add(rid)
+            part = df.reset_index(drop=True)
+            part.insert(0, "record_id", rid)
+            new_parts.append(part)
+        if not new_parts:
+            Log.debug(
+                f"_insert_columnar_frames: all {len(rids)} record(s) already in "
+                f"'{table_name}', skipped"
+            )
+            return 0
+        insert_df = new_parts[0] if len(new_parts) == 1 else pd.concat(new_parts, ignore_index=True)
+        col_str = ", ".join(f'"{c}"' for c in insert_df.columns)
+        self._duck.con.register("__columnar_insert", insert_df)
+        try:
+            self._duck.con.execute(
+                f'INSERT INTO "{table_name}" ({col_str}) '
+                f"SELECT {col_str} FROM __columnar_insert"
+            )
+        finally:
+            self._duck.con.unregister("__columnar_insert")
+        Log.debug(
+            f"_insert_columnar_frames: inserted {len(new_parts)} record(s), "
+            f"{len(insert_df)} row(s) into '{table_name}' "
+            f"({len(existing)} already stored)"
+        )
+        return len(new_parts)
diff --git a/scidb/tests/test_foreach_options.py b/scidb/tests/test_foreach_options.py
new file mode 100644
index 00000000..883aac2a
--- /dev/null
+++ b/scidb/tests/test_foreach_options.py
@@ -0,0 +1,97 @@
+"""One declaration of ``for_each``'s options (``scifor.options``), and the
+bundles scidb groups them into (``scidb.foreach_call``).
+
+Guards (P4 stage 2, design review 04b W3):
+
+* ``scidb.for_each``'s keyword signature IS ``SCIDB_FOR_EACH_OPTIONS`` — the
+  same names, order and defaults — so the declaration cannot drift from the
+  function users call;
+* ``scifor.for_each`` takes exactly the options that are not ``db_only``
+  (plus ``hooks``), with the same defaults;
+* ``scifor.DB_ONLY_KWARGS`` is derived from the declaration;
+* every option lands on a field of its bundle, and ``ForEachCall`` turns
+  back into the keywords it was built from (a deferred pipeline step replays
+  through that), so no recursion or replay can drop an option.
+"""
+
+import dataclasses
+import inspect
+
+import pytest
+import scidb
+import scifor
+from scidb.foreach_call import (
+    SCIDB_FOR_EACH_OPTIONS,
+    ForEachCall,
+    RunContext,
+    RunSelection,
+)
+from scidb.foreach_config import RunOptions
+from scifor import DB_ONLY_KWARGS, FOR_EACH_OPTIONS, UNSET
+
+_NOT_OPTIONS = {"fn", "inputs", "outputs", "hooks"}
+
+
+def _keyword_params(fn) -> "list[inspect.Parameter]":
+    return [
+        p
+        for name, p in inspect.signature(fn).parameters.items()
+        if name not in _NOT_OPTIONS and p.kind is not inspect.Parameter.VAR_KEYWORD
+    ]
+
+
+def test_scidb_signature_is_the_declaration():
+    params = _keyword_params(scidb.for_each)
+    assert [p.name for p in params] == [o.name for o in SCIDB_FOR_EACH_OPTIONS]
+    for p, spec in zip(params, SCIDB_FOR_EACH_OPTIONS, strict=True):
+        assert p.default is spec.default or p.default == spec.default, spec.name
+
+
+def test_scifor_signature_is_the_non_db_only_options():
+    params = {p.name: p for p in _keyword_params(scifor.for_each)}
+    shared = {o.name: o for o in FOR_EACH_OPTIONS if not o.db_only}
+    assert set(params) == set(shared)
+    for name, spec in shared.items():
+        assert params[name].default == spec.default, name
+
+
+def test_db_only_set_is_derived():
+    assert DB_ONLY_KWARGS == {o.name for o in FOR_EACH_OPTIONS if o.db_only}
+    assert "pipeline" in DB_ONLY_KWARGS and "where" not in DB_ONLY_KWARGS
+
+
+def test_pipeline_default_is_the_shared_sentinel():
+    assert inspect.signature(scidb.for_each).parameters["pipeline"].default is UNSET
+
+
+_BUNDLE_TYPES = {"run": RunOptions, "selection": RunSelection, "context": RunContext}
+
+
+@pytest.mark.parametrize("spec", SCIDB_FOR_EACH_OPTIONS, ids=lambda s: s.name)
+def test_every_option_has_a_field(spec):
+    holder = _BUNDLE_TYPES[spec.bundle] if spec.bundle is not None else ForEachCall
+    assert spec.attribute in {f.name for f in dataclasses.fields(holder)}
+
+
+def _all_options():
+    values = {o.name: o.default for o in SCIDB_FOR_EACH_OPTIONS}
+    values.update(dry_run=True, as_table=["x"], where="a > 1", step="s", _cancel_check=bool)
+    return values
+
+
+def test_call_round_trips_to_its_keywords():
+    options = _all_options()
+    call = ForEachCall.from_options(print, {"x": 1}, [], {"subject": [1]}, **options)
+    assert call.run == RunOptions(as_table=["x"])
+    assert call.selection.where == "a > 1"
+    assert call.selection.metadata_iterables == {"subject": [1]}
+    assert call.context.step == "s" and call.context.cancel_check is bool
+    expected = {k: v for k, v in options.items() if k != "pipeline"}
+    assert call.option_values() == expected
+
+
+def test_a_missing_option_fails_loudly():
+    options = _all_options()
+    options.pop("glue")
+    with pytest.raises(TypeError, match="glue"):
+        ForEachCall.from_options(print, {}, [], {}, **options)
diff --git a/scidb/tests/test_latest_null_schema_id.py b/scidb/tests/test_latest_null_schema_id.py
new file mode 100644
index 00000000..39c2c0c8
--- /dev/null
+++ b/scidb/tests/test_latest_null_schema_id.py
@@ -0,0 +1,120 @@
+"""THE supersession ("latest") rule, including a NULL ``schema_id``.
+
+``provenance_query.latest_at_location_batch`` is the one owner (P4 stage 4,
+design review 04c Q1). Before it, three copies answered "is this record still
+the newest at its location": ``DatabaseManager.get_latest_record_id_for_variant``
+(the variant half), ``state._get_latest_record_at_location`` (any variant) and
+the batch function, which "mirrored" the two and differed from them on NULL
+``schema_id``. What each returned for a NULL-``schema_id`` record, recorded
+before the copies were deleted:
+
+* variant half: NULL-safe (``IS NOT DISTINCT FROM``) — the record itself when
+  it has save events, None when it has none (a constant record);
+* any-variant half: ``TypeError`` (``int(None)``) — it never ran on one in
+  practice, because only constant, PathInput and constant-glue records have a
+  NULL ``schema_id`` and none of them is a variable input;
+* batch: NULL-safe variant half, ``latest_any = None``.
+
+The batch behaviour is the rule now; the only caller whose behaviour changed
+is the any-variant half (raise -> None), on input it was never given.
+"""
+
+import numpy as np
+import pytest
+
+import scifor as _scifor
+from scidb import BaseVariable, configure_database, for_each
+from scidb import provenance_query
+from scidb.state import _has_superseded_ancestor
+
+
+class LatestIn(BaseVariable):
+    pass
+
+
+class LatestOut(BaseVariable):
+    pass
+
+
+def scale(x, k):
+    return x * k
+
+
+@pytest.fixture
+def db(tmp_path):
+    _scifor.set_schema([])
+    database = configure_database(tmp_path / "latest.duckdb", ["subject"])
+    yield database
+    _scifor.set_schema([])
+    database.close()
+
+
+def _rid(db, type_name, subject):
+    rows = db._duck.fetchall(
+        "SELECT r.record_id FROM _record r JOIN _schema s ON s.schema_id = r.schema_id "
+        "WHERE r.type = ? AND s.subject = ?",
+        [type_name, str(subject)],
+    )
+    assert len(rows) == 1
+    return rows[0][0]
+
+
+def _latest(db, rid):
+    return provenance_query.latest_at_location_batch(db._duck, [rid])[rid]
+
+
+def test_a_record_is_latest_until_resaved(db):
+    LatestIn.save(np.arange(3.0), db=db, subject=1)
+    first = _rid(db, "LatestIn", 1)
+    assert _latest(db, first)["latest_variant"] == first
+    assert _latest(db, first)["latest_any"] == first
+
+    LatestIn.save(np.arange(3.0) + 10, db=db, subject=1)
+    info = _latest(db, first)
+    assert info["latest_variant"] != first
+    assert info["latest_any"] == info["latest_variant"]
+
+
+def test_staleness_follows_the_owner(db):
+    """A downstream record goes stale when its input is re-saved."""
+    LatestIn.save(np.arange(3.0), db=db, subject=1)
+    for_each(scale, {"x": LatestIn, "k": 2}, [LatestOut], subject=[1], db=db)
+    out = _rid(db, "LatestOut", 1)
+    assert not _has_superseded_ancestor(db, out, "subject=1")
+    assert provenance_query.superseded_batch(db._duck, [out]) == {out: False}
+
+    LatestIn.save(np.arange(3.0) + 1, db=db, subject=1)
+    assert _has_superseded_ancestor(db, out, "subject=1")
+    assert provenance_query.superseded_batch(db._duck, [out]) == {out: True}
+
+
+def test_null_schema_id_with_save_events(db):
+    """A record moved to a NULL schema_id: the variant half still finds it
+    (NULL-safe), the any-variant half reports nothing."""
+    LatestIn.save(np.arange(3.0), db=db, subject=1)
+    rid = _rid(db, "LatestIn", 1)
+    db._duck.execute("UPDATE _record SET schema_id = NULL WHERE record_id = ?", [rid])
+    info = _latest(db, rid)
+    assert info["schema_id"] is None
+    assert info["latest_variant"] == rid
+    assert info["latest_any"] is None
+
+
+def test_null_schema_id_without_save_events(db):
+    """A constant record: NULL schema_id and no save event — nothing is
+    newest there under either half."""
+    LatestIn.save(np.arange(3.0), db=db, subject=1)
+    for_each(scale, {"x": LatestIn, "k": 3}, [LatestOut], subject=[1], db=db)
+    (const_rid,) = [
+        r[0]
+        for r in db._duck.fetchall("SELECT record_id FROM _record WHERE type = '__constant__'")
+    ]
+    info = _latest(db, const_rid)
+    assert info["schema_id"] is None
+    assert info["latest_variant"] is None
+    assert info["latest_any"] is None
+
+
+def test_a_vanished_record_reads_as_superseded(db):
+    info = _latest(db, "no-such-record")
+    assert info["latest_variant"] is None and info["type"] is None
diff --git a/scidb/tests/test_record_store.py b/scidb/tests/test_record_store.py
new file mode 100644
index 00000000..3c0e2e88
--- /dev/null
+++ b/scidb/tests/test_record_store.py
@@ -0,0 +1,122 @@
+"""``RecordStore`` (``scidb.record_store``): the one owner of the storage SQL.
+
+Guards (P4 stage 5, design review 04a B2 / 06 PD1):
+
+* the long frame plotting reads holds every non-excluded record, schema keys
+  as TEXT, and — in its metadata-only form — no data column in the query;
+* the payload only ever travels through ``fetchdf``, never ``fetchall``
+  (``.claude/plot-at-scale-plan.md`` §7: 18x, a Python float per sample);
+* the catalog reads (table, columns, dtype, occupied keys, a sampled cell,
+  distinct levels) answer from the stored tables;
+* ``save_batch``'s inserts run through ``write_batch_rows`` on the same store
+  ``db.record_store`` hands out, rebuilt when the connection is replaced.
+"""
+
+import numpy as np
+import pytest
+
+import scifor as _scifor
+from scidb import BaseVariable, configure_database
+from scidb.record_store import RecordStore
+
+
+class StoreSignal(BaseVariable):
+    pass
+
+
+class StoreScalar(BaseVariable):
+    pass
+
+
+@pytest.fixture
+def db(tmp_path):
+    _scifor.set_schema([])
+    database = configure_database(tmp_path / "store.duckdb", ["subject", "trial"])
+    for s in (1, 2):
+        for t in (1, 2):
+            StoreSignal.save(np.arange(4.0) * s + t, db=database, subject=s, trial=t)
+            StoreScalar.save(float(s * 10 + t), db=database, subject=s, trial=t)
+    yield database
+    _scifor.set_schema([])
+    database.close()
+
+
+def _spy(monkeypatch, duck, name):
+    seen: list = []
+    real = getattr(duck, name)
+
+    def spy(sql, *args, **kwargs):
+        seen.append(sql)
+        return real(sql, *args, **kwargs)
+
+    monkeypatch.setattr(duck, name, spy)
+    return seen
+
+
+def test_db_hands_out_one_store_per_connection(db):
+    assert isinstance(db.record_store, RecordStore)
+    assert db.record_store is db.record_store
+    assert db.record_store.connection is db._duck
+
+
+def test_catalog(db):
+    store = db.record_store
+    assert store.schema_keys() == ["subject", "trial"]
+    assert {"StoreSignal", "StoreScalar"} <= set(store.variable_names())
+    assert store.table_name("StoreSignal")
+    assert list(store.stored_column_types("StoreScalar"))
+    assert store.dtype_meta("StoreScalar") is not None
+    assert store.dtype_meta("NoSuchVariable") is None
+    assert store.occupied_keys("StoreScalar") == ["subject", "trial"]
+
+
+def test_long_frame_reads_every_record_with_text_keys(db, monkeypatch):
+    store = db.record_store
+    (column,) = list(store.stored_column_types("StoreScalar"))
+    fetchdf = _spy(monkeypatch, db._duck, "fetchdf")
+    frame = store.long_frame("StoreScalar", [column])
+    assert len(frame) == 4
+    assert list(frame.columns) == ["record_id", column, "subject", "trial"]
+    assert sorted(frame["subject"].astype(str)) == ["1", "1", "2", "2"]
+    assert len(fetchdf) == 1 and "CAST(" in fetchdf[0]
+
+
+def test_metadata_only_long_frame_selects_no_data_column(db, monkeypatch):
+    store = db.record_store
+    columns = list(store.stored_column_types("StoreSignal"))
+    fetchdf = _spy(monkeypatch, db._duck, "fetchdf")
+    frame = store.long_frame("StoreSignal")
+    assert list(frame.columns) == ["record_id", "subject", "trial"]
+    assert len(frame) == 4
+    for column in columns:
+        assert f'"{column}"' not in fetchdf[0]
+
+
+def test_payload_never_goes_through_fetchall(db, monkeypatch):
+    store = db.record_store
+    columns = list(store.stored_column_types("StoreSignal"))
+    fetchall = _spy(monkeypatch, db._duck, "fetchall")
+    store.long_frame("StoreSignal", columns)
+    for sql in fetchall:
+        for column in columns:
+            assert f't."{column}"' not in sql, sql
+
+
+def test_sample_and_levels(db):
+    store = db.record_store
+    (column,) = list(store.stored_column_types("StoreScalar"))
+    assert store.sample_cell("StoreScalar", column) is not None
+    levels = store.column_levels("StoreScalar", column, limit=10)
+    assert sorted(levels, key=float) == ["11.0", "12.0", "21.0", "22.0"]
+    assert len(store.column_levels("StoreScalar", column, limit=2)) == 2
+
+
+def test_save_batch_inserts_through_the_store(db, monkeypatch):
+    calls = []
+    real = db.record_store.write_batch_rows
+    monkeypatch.setattr(
+        db.record_store, "write_batch_rows", lambda rows: calls.append(rows) or real(rows)
+    )
+    rids = db.save_batch(StoreScalar, [(99.0, {"subject": 3, "trial": 1})])
+    assert len(calls) == 1 and calls[0].record_ids == rids
+    assert db.record_store.occupied_keys("StoreScalar") == ["subject", "trial"]
diff --git a/scidb/tests/test_save_plan.py b/scidb/tests/test_save_plan.py
new file mode 100644
index 00000000..682b554f
--- /dev/null
+++ b/scidb/tests/test_save_plan.py
@@ -0,0 +1,129 @@
+"""A ``for_each`` save is ``build_save_plan`` -> ``apply_save_plan``.
+
+Characterizes the plan (P4 stage 3, design review 04b W2) on a two-output
+run and a ``distribute`` run: which batches it holds, how many records each,
+the input edges of every record, and that one invocation id is shared by
+everything one call produced. Also pins that the plan writes nothing (the
+writes, and their all-or-nothing transaction, are ``apply_save_plan``'s;
+``test_save_provenance_failure.py`` covers the rollback) and that a re-run
+yields the same record ids.
+"""
+
+import numpy as np
+import pytest
+
+import scidb.foreach as scidb_foreach
+import scifor as _scifor
+from scidb import BaseVariable, configure_database, for_each
+
+
+class PlanIn(BaseVariable):
+    pass
+
+
+class PlanOutA(BaseVariable):
+    pass
+
+
+class PlanOutB(BaseVariable):
+    pass
+
+
+class PlanPieces(BaseVariable):
+    pass
+
+
+def two_outputs(x):
+    return x * 2, x * 3
+
+
+def three_pieces(x):
+    return np.array([x.sum(), x.sum() + 1, x.sum() + 2])
+
+
+@pytest.fixture
+def db(tmp_path):
+    _scifor.set_schema([])
+    database = configure_database(tmp_path / "save_plan.duckdb", ["subject", "trial"])
+    for s in (1, 2):
+        PlanIn.save(np.arange(3.0) + s, db=database, subject=s)
+    yield database
+    _scifor.set_schema([])
+    database.close()
+
+
+@pytest.fixture
+def plans(monkeypatch):
+    """Every SavePlan built during the test, in order."""
+    seen = []
+    real = scidb_foreach.build_save_plan
+
+    def spy(*args, **kwargs):
+        plan = real(*args, **kwargs)
+        seen.append(plan)
+        return plan
+
+    monkeypatch.setattr(scidb_foreach, "build_save_plan", spy)
+    return seen
+
+
+def _record_ids(db, type_name):
+    return sorted(
+        r[0]
+        for r in db._duck.fetchall("SELECT record_id FROM _record WHERE type = ?", [type_name])
+    )
+
+
+def test_two_output_plan(db, plans):
+    for_each(two_outputs, {"x": PlanIn}, [PlanOutA, PlanOutB], subject=[1, 2], db=db)
+    (plan,) = plans
+    assert plan.output_names == ["PlanOutA", "PlanOutB"]
+    assert set(plan.batches) == {(0, "normal"), (1, "normal")}
+    assert [len(items) for items in plan.batches.values()] == [2, 2]
+    assert plan.generated == [] and plan.no_output_reasons == {}
+
+    for items in plan.batches.values():
+        for item in items:
+            assert [e.param for e in item.edges] == ["x"]
+    # The two outputs of one call share its invocation; the two calls differ.
+    by_subject: dict = {}
+    for items in plan.batches.values():
+        for item in items:
+            by_subject.setdefault(item.metadata["subject"], set()).add(
+                item.metadata["__invocation_id"]
+            )
+    assert all(len(ids) == 1 for ids in by_subject.values())
+    assert len({next(iter(ids)) for ids in by_subject.values()}) == 2
+
+
+def test_distribute_plan(db, plans):
+    for_each(
+        three_pieces, {"x": PlanIn}, [PlanPieces], subject=[1, 2], distribute=True, db=db
+    )
+    (plan,) = plans
+    (items,) = plan.batches.values()
+    assert len(items) == 6
+    assert sorted({str(i.metadata["trial"]) for i in items}) == ["1", "2", "3"]
+    assert all(len(i.edges) == 1 for i in items)
+    # Every piece of one call carries that call's invocation id.
+    assert len({i.metadata["__invocation_id"] for i in items}) == 2
+    assert len(_record_ids(db, "PlanPieces")) == 6
+
+
+def test_plan_writes_nothing(db, plans, monkeypatch):
+    # Applying nothing: whatever reaches the database came from the plan.
+    monkeypatch.setattr(
+        scidb_foreach, "apply_save_plan", lambda plan, state, database: scidb_foreach.SaveReport()
+    )
+    for_each(two_outputs, {"x": PlanIn}, [PlanOutA, PlanOutB], subject=[1, 2], db=db)
+    (plan,) = plans
+    assert sum(len(items) for items in plan.batches.values()) == 4
+    assert _record_ids(db, "PlanOutA") == [] and _record_ids(db, "PlanOutB") == []
+
+
+def test_rerun_keeps_record_ids(db):
+    for_each(two_outputs, {"x": PlanIn}, [PlanOutA, PlanOutB], subject=[1, 2], db=db)
+    first = (_record_ids(db, "PlanOutA"), _record_ids(db, "PlanOutB"))
+    for_each(two_outputs, {"x": PlanIn}, [PlanOutA, PlanOutB], subject=[1, 2], db=db)
+    assert (_record_ids(db, "PlanOutA"), _record_ids(db, "PlanOutB")) == first
+    assert all(len(ids) == 2 for ids in first)
diff --git a/scifor/src/scifor/hooks.py b/scifor/src/scifor/hooks.py
new file mode 100644
index 00000000..5681e06d
--- /dev/null
+++ b/scifor/src/scifor/hooks.py
@@ -0,0 +1,88 @@
+"""``LoopHooks``: how a layer above ``scifor.for_each`` drives its loop.
+
+``scifor.for_each`` is a pure loop over plain tables. A caller that knows
+more than the tables say (scidb knows which records each combination reads,
+how a variable is stored, and which combinations already exist) passes that
+knowledge in through ONE object instead of eight private keyword arguments.
+Users of standalone scifor never need it.
+
+Every field defaults to "no opinion", so ``LoopHooks()`` behaves exactly like
+passing no hooks at all.
+"""
+
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    import pandas as pd
+
+    from .pathinput import PathInput
+
+
+@dataclass(frozen=True)
+class LoopHooks:
+    """Caller-supplied knowledge for one ``scifor.for_each`` run.
+
+    Attributes:
+        all_combos: The combinations to run, as ``{key: value}`` dicts,
+            already decided by the caller. Replaces the Cartesian product of
+            the metadata iterables (and the empty-list resolution and
+            PathInput discovery that feed it). scidb passes the combinations
+            that exist in the database, after applying the database's
+            schema-key types itself; ``locations=`` still narrows them.
+        path_input_resolver: ``(pathinput, metadata) -> path`` override for
+            resolving a ``PathInput`` per combination. scidb uses it to
+            enforce the database's schema-key types (a string key matches
+            exactly; an undeclared key that needs zero-padding raises).
+            Default: ``pathinput.load(**metadata)``, or the exact-match
+            resolver when ``schema_key_types=`` declares a string key.
+        mapping_inputs: ``{input_name: [data column names]}`` naming inputs
+            whose rows are records of a *mapping-valued* variable (each row
+            one dict, spread one column per key) rather than rows of a
+            table. A single row of such an input reaches the function as
+            that dict (a struct in MATLAB), not as a one-row frame. scifor
+            cannot infer this: "one row, N data columns" is also exactly
+            what a table-valued variable looks like, so the layer that knows
+            the storage layout says so (scidb's ``_resolve_mapping_inputs``).
+            Ignored for an input passed through ``as_table`` or with a column
+            selection.
+        select_rows: ``(input_name, frame, metadata) -> frame``, called on
+            every per-combination DataFrame input AFTER scifor's own
+            schema-key filter and BEFORE extraction / column selection. A
+            caller that knows which rows a combination reads more precisely
+            than the schema keys say narrows the frame here, and drops any
+            bookkeeping column of its own before the function sees it
+            (scidb: its record-id column, matched against the combination's
+            ``Selection``). A frame the caller has nothing to say about must
+            be returned unchanged.
+        keep_no_output: Leave ``NoOutput`` slots (an output with nothing to
+            save at a combination whose other outputs were kept) in the
+            returned table, for a caller that saves per output and skips
+            them (scidb). Default: each becomes ``None``, a missing cell.
+        progress_fn: Receives one dict per loop event: ``combo_start``,
+            ``combo_done``, ``combo_skip`` (with a small ``failure``),
+            ``cancelled``, and a final ``summary`` carrying the counts and
+            the failure groups. The GUI's progress bar and scidb's run
+            summary read these.
+        cancel_check: Called before each combination (and between EachOf
+            alternatives); returning True stops the run cooperatively. The
+            combinations already finished are still returned.
+    """
+
+    all_combos: "list[dict] | None" = None
+    path_input_resolver: "Callable[[PathInput, dict], Any] | None" = None
+    mapping_inputs: "dict[str, list[str]] | None" = None
+    select_rows: "Callable[[str, pd.DataFrame, dict], pd.DataFrame] | None" = None
+    keep_no_output: bool = False
+    progress_fn: "Callable[[dict], None] | None" = None
+    cancel_check: "Callable[[], bool] | None" = None
+
+    def cancelled(self) -> bool:
+        """Has the caller asked the run to stop?"""
+        return self.cancel_check is not None and bool(self.cancel_check())
+
+    def emit(self, event: dict) -> None:
+        """Send one loop event to ``progress_fn`` (no-op without one)."""
+        if self.progress_fn is not None:
+            self.progress_fn(event)
diff --git a/scifor/src/scifor/options.py b/scifor/src/scifor/options.py
new file mode 100644
index 00000000..6efd03b1
--- /dev/null
+++ b/scifor/src/scifor/options.py
@@ -0,0 +1,112 @@
+"""The ONE declaration of ``for_each``'s options.
+
+``scifor.for_each`` and ``scidb.for_each`` are drop-in replacements for one
+another by keyword. Until this declaration existed the option list lived in
+four places (scidb's signature, scifor's, MATLAB's ``split_options`` and the
+GUI's MATLAB command generation) and drifted: a kwarg one side did not know
+landed in ``**metadata_iterables`` as a bogus iteration axis.
+
+:data:`FOR_EACH_OPTIONS` lists every user option ``scidb.for_each`` takes
+(scifor cannot import scidb, so the declaration lives here and scidb extends
+it with its private hooks). Everything else is derived:
+
+* :data:`DB_ONLY_KWARGS` — the options only a database gives meaning to;
+  ``scifor.for_each`` accepts and discards them;
+* ``scidb/tests/test_foreach_options.py`` holds both signatures to this list
+  (names and defaults);
+* scidb groups the options into bundles by :attr:`OptionSpec.bundle`.
+
+``fn``, ``inputs`` and ``outputs`` are positional arguments, not options, and
+``**metadata_iterables`` are iteration axes; none of them appear here.
+"""
+
+from dataclasses import dataclass
+from typing import Any, Literal
+
+#: Where scidb keeps an option once ``for_each`` has bundled it:
+#: ``"run"`` — ``scidb.foreach_config.RunOptions`` (identity-bearing modes);
+#: ``"selection"`` — which locations and rows the call reads;
+#: ``"context"`` — facts about the call that are recorded or steer it but are
+#: never identity; ``None`` — read directly by ``for_each``.
+Bundle = Literal["run", "selection", "context"]
+
+#: The shape of an option's value, for code that writes a ``for_each`` call
+#: in another language (MATLAB ``split_options``, GUI command generation).
+Kind = Literal["bool", "str", "names", "mapping", "filter", "path", "object"]
+
+
+class _Unset:
+    """The default of an option whose omission means something different
+    from ``None`` (``pipeline``: omitted = use the active pipeline)."""
+
+    _instance: "_Unset | None" = None
+
+    def __new__(cls) -> "_Unset":
+        if cls._instance is None:
+            cls._instance = super().__new__(cls)
+        return cls._instance
+
+    def __repr__(self) -> str:
+        return "UNSET"
+
+
+UNSET: Any = _Unset()
+
+
+@dataclass(frozen=True)
+class OptionSpec:
+    """One ``for_each`` keyword option.
+
+    ``name`` is the keyword; ``default`` its default in both signatures;
+    ``kind`` the shape of its value; ``bundle`` where scidb groups it;
+    ``db_only`` whether only ``scidb.for_each`` acts on it (scifor discards
+    it with one INFO line).
+    """
+
+    name: str
+    default: Any
+    kind: Kind
+    bundle: "Bundle | None" = None
+    db_only: bool = False
+
+    @property
+    def attribute(self) -> str:
+        """The field that holds this option on its bundle: the name without
+        a leading underscore (``_progress_fn`` -> ``progress_fn``)."""
+        return self.name.lstrip("_")
+
+
+FOR_EACH_OPTIONS: "tuple[OptionSpec, ...]" = (
+    OptionSpec("dry_run", False, "bool"),
+    OptionSpec("save", True, "bool", db_only=True),
+    OptionSpec("as_table", None, "names", "run"),
+    OptionSpec("db", None, "object", db_only=True),
+    OptionSpec("distribute", False, "bool", "run"),
+    OptionSpec("where", None, "filter", "selection"),
+    OptionSpec("introspect", False, "bool", db_only=True),
+    OptionSpec("skip_computed", False, "bool", db_only=True),
+    OptionSpec("schema_filter", None, "mapping", "selection", db_only=True),
+    OptionSpec("schema_keys", None, "names", "selection"),
+    OptionSpec("schema_key_types", None, "mapping"),
+    OptionSpec("on_error", "continue", "str"),
+    # scidb.combine: two result rows at one location saved as one record.
+    OptionSpec("on_duplicate", "error", "str", db_only=True),
+    OptionSpec("locations", None, "mapping", "selection"),
+    OptionSpec("share_limits", None, "mapping"),
+    OptionSpec("project_root", None, "path"),
+    OptionSpec("finalized", False, "bool", "context", db_only=True),
+    OptionSpec("glue", None, "mapping", db_only=True),
+    OptionSpec("parameter_names", None, "mapping", "context", db_only=True),
+    OptionSpec("step", None, "str", "context", db_only=True),
+    OptionSpec("pipeline", UNSET, "object", "context", db_only=True),
+)
+
+DB_ONLY_KWARGS: "frozenset[str]" = frozenset(o.name for o in FOR_EACH_OPTIONS if o.db_only)
+
+
+def option(name: str) -> OptionSpec:
+    """The declaration of option *name* (KeyError if there is none)."""
+    for spec in FOR_EACH_OPTIONS:
+        if spec.name == name:
+            return spec
+    raise KeyError(name)
diff --git a/scifor/tests/test_run_plan.py b/scifor/tests/test_run_plan.py
new file mode 100644
index 00000000..3df61112
--- /dev/null
+++ b/scifor/tests/test_run_plan.py
@@ -0,0 +1,205 @@
+"""``scifor.for_each`` is ``plan_run`` -> ``run_combo`` per combo -> ``assemble``.
+
+Characterizes the planning phase on its own (P4 stage 1, design review 02 R1):
+the combos, output names, as_table set, distribute target and for_columns
+axis it decides must be what the single 1,200-line ``for_each`` decided
+before the split. Also pins the two contracts the split introduced:
+
+* ``run_combo`` RETURNS a failure (the loop decides skip vs. stop) instead
+  of raising it;
+* loop hooks travel in ``hooks=LoopHooks(...)``; a leftover ``_progress_fn=``
+  raises instead of silently becoming an iteration axis.
+"""
+
+import pandas as pd
+import pytest
+
+from scifor import ColumnSelection, LocationFilter, LoopHooks, for_each, set_schema
+from scifor.foreach import RunTally, plan_run, run_combo
+
+
+def setup_function():
+    set_schema(["subject", "session"])
+
+
+def _df():
+    return pd.DataFrame(
+        {
+            "subject": [1, 1, 2, 2],
+            "session": ["pre", "post", "pre", "post"],
+            "a": [1.0, 2.0, 3.0, 4.0],
+            "b": [5.0, 6.0, 7.0, 8.0],
+        }
+    )
+
+
+def _plan(inputs, outputs=None, hooks=None, **kwargs):
+    metadata = {k: kwargs.pop(k) for k in list(kwargs) if k in ("subject", "session", "trial")}
+    return plan_run(
+        lambda **kw: None,
+        inputs,
+        outputs,
+        metadata,
+        hooks=hooks or LoopHooks(),
+        key_types={},
+        **kwargs,
+    )
+
+
+# --- plan_run ------------------------------------------------------------------
+
+
+def test_cartesian_combos_in_key_order():
+    plan = _plan({"x": _df()}, ["out"], subject=[1, 2], session=["pre", "post"])
+    assert plan.keys == ["subject", "session"]
+    assert plan.combos == [
+        {"subject": 1, "session": "pre"},
+        {"subject": 1, "session": "post"},
+        {"subject": 2, "session": "pre"},
+        {"subject": 2, "session": "post"},
+    ]
+    assert plan.total == 4
+    assert plan.output_names == ["out"]
+
+
+@pytest.mark.parametrize(
+    "outputs, names",
+    [(None, ["output"]), (2, ["output_1", "output_2"]), (["p", "q"], ["p", "q"])],
+)
+def test_output_names(outputs, names):
+    assert _plan({"x": _df()}, outputs, subject=[1]).output_names == names
+
+
+def test_empty_list_resolves_from_dataframe_inputs():
+    plan = _plan({"x": _df()}, subject=[], session=["pre"])
+    assert plan.metadata_iterables["subject"] == [1, 2]
+    assert [c["subject"] for c in plan.combos] == [1, 2]
+
+
+def test_data_and_constant_inputs_and_as_table():
+    inputs = {"x": _df(), "y": _df(), "k": 3}
+    plan = _plan(inputs, subject=[1], as_table=["y"])
+    assert set(plan.data_inputs) == {"x", "y"}
+    assert plan.constant_inputs == {"k": 3}
+    assert plan.as_table_set == {"y"}
+    assert _plan(inputs, subject=[1], as_table=True).as_table_set == {"x", "y"}
+    assert _plan(inputs, subject=[1]).as_table_set == set()
+
+
+def test_prebuilt_combos_win_and_locations_still_narrow_them():
+    combos = [{"subject": 1, "session": "pre"}, {"subject": 2, "session": "pre"}]
+    plan = _plan(
+        {"x": _df()},
+        hooks=LoopHooks(all_combos=combos),
+        subject=[1, 2, 3],
+        session=["pre", "post"],
+        locations=LocationFilter.build(include=[[("subject", 2)]]),
+    )
+    assert plan.combos == [{"subject": 2, "session": "pre"}]
+
+
+def test_distribute_target_is_one_level_below_the_deepest_iterated_key():
+    set_schema(["subject", "session", "trial"])
+    plan = _plan({"x": _df()}, subject=[1], session=["pre"], distribute=True)
+    assert plan.distribute_key == "trial"
+    assert _plan({"x": _df()}, subject=[1]).distribute_key is None
+
+
+def test_for_columns_axis():
+    plan = _plan(
+        {"x": ColumnSelection(_df(), ["a", "b"], iterate=True)},
+        subject=[1],
+        session=["pre"],
+    )
+    assert plan.for_columns is not None
+    assert plan.iterate_params == ["x"]
+    assert plan.for_columns.columns == ["a", "b"]
+    assert plan.for_columns is not None and plan.for_columns.mode
+
+
+def test_plan_does_not_call_the_function():
+    calls = []
+    plan_run(
+        lambda x: calls.append(x),
+        {"x": _df()},
+        None,
+        {"subject": [1, 2]},
+        hooks=LoopHooks(),
+        key_types={},
+    )
+    assert calls == []
+
+
+def test_option_parts_name_only_non_default_options():
+    assert _plan({"x": _df()}, subject=[1]).option_parts == ()
+    plan = _plan({"x": _df()}, subject=[1], dry_run=True, as_table=True)
+    assert plan.option_parts == ("dry_run=True", "as_table=True")
+
+
+# --- run_combo -----------------------------------------------------------------
+
+
+def test_run_combo_returns_rows():
+    plan = plan_run(
+        lambda x: x * 10,
+        {"x": ColumnSelection(_df(), ["a"])},
+        ["y"],
+        {"subject": [1], "session": ["pre"]},
+        hooks=LoopHooks(),
+        key_types={},
+    )
+    outcome = run_combo(plan, plan.combos[0], LoopHooks(), RunTally())
+    assert outcome.failure is None
+    [(meta, values)] = outcome.rows
+    assert meta == {"subject": 1, "session": "pre"}
+    assert values == (10.0,)
+
+
+def test_run_combo_returns_a_failure_instead_of_raising():
+    def broken(x):
+        raise KeyError("missing_channel")
+
+    plan = plan_run(
+        broken,
+        {"x": _df()},
+        ["y"],
+        {"subject": [1], "session": ["pre"]},
+        hooks=LoopHooks(),
+        key_types={},
+    )
+    tally = RunTally()
+    outcome = run_combo(plan, plan.combos[0], LoopHooks(), tally)
+    assert outcome.rows == []
+    assert outcome.failure is not None and not outcome.failure.no_data
+    assert isinstance(outcome.error, KeyError)
+    assert len(tally.failure_groups) == 1
+
+
+# --- for_each entry --------------------------------------------------------------
+
+
+def test_private_keyword_raises_instead_of_becoming_an_axis():
+    with pytest.raises(TypeError, match="hooks=LoopHooks"):
+        for_each(lambda x: x, {"x": _df()}, subject=[1], _progress_fn=print)
+
+
+def test_hooks_default_is_no_hooks():
+    events = []
+    with_hooks = for_each(
+        lambda x: x,
+        {"x": ColumnSelection(_df(), ["a"])},
+        subject=[1, 2],
+        session=["pre"],
+        hooks=LoopHooks(progress_fn=events.append),
+    )
+    without = for_each(
+        lambda x: x, {"x": ColumnSelection(_df(), ["a"])}, subject=[1, 2], session=["pre"]
+    )
+    pd.testing.assert_frame_equal(with_hooks, without)
+    assert [e["event"] for e in events] == [
+        "combo_start",
+        "combo_done",
+        "combo_start",
+        "combo_done",
+        "summary",
+    ]
diff --git a/scistackplotdb/tests/test_load_through_record_store.py b/scistackplotdb/tests/test_load_through_record_store.py
new file mode 100644
index 00000000..73c2886c
--- /dev/null
+++ b/scistackplotdb/tests/test_load_through_record_store.py
@@ -0,0 +1,41 @@
+"""``scistackplotdb.load`` reads a variable's records through scidb's
+``RecordStore``; it writes no storage SQL of its own.
+
+Before P4 stage 5 (design review 06 PD1) the bulk load of a variable existed
+twice: ``DatabaseManager.load_all_as_df`` and this module's own SELECTs
+against ``_registered_types``, ``_variables``, ``information_schema`` and the
+data tables. The plot-at-scale behaviour (metadata-only mode selects no data
+column; payload only through ``fetchdf``) is pinned by
+``test_load_fetch.py`` and ``test_variant_table.py``; this file pins where
+the SQL lives, and that the load still goes through the store's long frame.
+"""
+
+import re
+from pathlib import Path
+
+from scistackplotdb import load as load_mod
+
+#: A query string: a string literal (f-string or plain) that opens with a
+#: statement keyword.
+_QUERY = re.compile(r"""f?["'](SELECT|INSERT|UPDATE|DELETE|WITH)\b""")
+
+
+def test_load_module_has_no_storage_sql():
+    code = Path(load_mod.__file__).read_text(encoding="utf-8")
+    assert _QUERY.findall(code) == [], "storage SQL belongs in scidb.record_store"
+    assert "_duck.fetch" not in code and "_duck.execute" not in code
+
+
+def test_load_variable_reads_the_store_long_frame(seeded, monkeypatch):
+    calls = []
+    store = seeded.record_store
+    real = store.long_frame
+
+    def spy(type_name, columns=()):
+        calls.append((type_name, list(columns)))
+        return real(type_name, columns)
+
+    monkeypatch.setattr(store, "long_frame", spy)
+    frame = load_mod.load_variable(seeded, "Emg", include_data=False)
+    assert calls == [("Emg", [])]
+    assert frame.data_columns == []
