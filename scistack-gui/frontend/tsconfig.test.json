// Build only the REACT-FREE modules and their tests, so `npm test` can run them
// under node's built-in test runner (node --test).
//
// The same split — and the same reason — as extension/tsconfig.test.json: a
// rule with no way to execute it in a test is a rule that drifts. The main
// tsconfig is noEmit with a bundler resolver and JSX, none of which node can
// run; this one emits plain ESM for the handful of files that are pure logic.
//
// Keep the include list explicit. A file added here must have no React, no DOM
// and no imports that reach either, or `npm test` starts failing for reasons
// that have nothing to do with the rule under test.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/test",
    "noEmit": false,
    "jsx": "preserve",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": [
    "src/webviewRpc.ts",
    "src/webviewRpc.test.ts",
    "src/components/PlotStudio/locationSelection.ts",
    "src/components/PlotStudio/locationSelection.test.ts",
    "src/components/PlotStudio/groups.ts",
    "src/components/PlotStudio/groups.test.ts",
    "src/components/PlotStudio/showSample.ts",
    "src/components/PlotStudio/showSample.test.ts",
    "src/components/PlotStudio/figureSize.ts",
    "src/components/PlotStudio/figureSize.test.ts",
    "src/components/PlotStudio/preview.ts",
    "src/components/PlotStudio/preview.test.ts",
    "src/components/PlotStudio/savedPlots.ts",
    "src/components/PlotStudio/savedPlots.test.ts",
    "src/components/PlotStudio/pickerCanvas.test.ts",
    "src/components/Variants/topologies.ts",
    "src/components/Variants/topologies.test.ts",
    "src/components/Sidebar/sourceLocation.ts",
    "src/components/Sidebar/sourceLocation.test.ts"
  ]
}
